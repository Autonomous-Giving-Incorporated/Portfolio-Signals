# Public publish exclusions for the portal, workspace shell, and aggregates.
# This is a denylist, not an allowlist; verify actual Wrangler discovery in CI.
# Hidden tool/config files are private at EVERY depth, including newly generated
# .mcp.json, .claude/, .codex/, .agents/, .dev.vars and editor/cache artifacts.
# Only the root web-standard discovery directory is public; hidden descendants
# remain excluded. Review any additional exception with the asset regression.
**/.*
!/.well-known

.git
.github
.idea
.vscode
.vercel
.wrangler
node_modules
graft
out
test-results
playwright-report
supabase
services
workers
scripts
docs
tests
fixtures
templates
platform-spec
.cursor
.nvmrc
.tool-versions

.env
.env.*
*.xlsx
*.csv

# Tooling / source control (not the public portal)
wrangler.toml
vercel.json
.vercelignore
.assetsignore
.gitignore
package.json
package-lock.json
playwright.config.js
deno.json
platform-conformance.yml
LICENSE
SECURITY.md
README.md
ROADMAP.md
TODO.md
design-qa.md
*.md

runtime-config.example.js
scripts/staging/bootstrap.env
