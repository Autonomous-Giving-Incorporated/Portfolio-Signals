NODE_ENV=production
ORG_ID=org_hacker_dojo
PORT=8787
DATA_FILE=/data/state.json
PROOF_SLA_HOURS=72
PUBLIC_BASE_URL=https://agi-allocation.fly.dev

# every.org webhook auth (required in production)
WEBHOOK_TOKEN=change-me-min-16-chars

# Director login (preferred) — Fund-Intel Supabase project (issue #72)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# After keys are set:
#   DIRECTOR_EMAIL=you@example.com npm run grant:director
#   npm run verify:director -- --login
# ALLOW_OPERATOR_TOKEN_FALLBACK=0

# Pilot-grade fallback when Supabase not configured yet
# OPERATOR_TOKEN=change-me-min-16-chars
# ALLOW_OPERATOR_TOKEN_FALLBACK=1

# First deploy / empty volume only; set 0 after stable
SEED_ON_BOOT=1
SEED_ALLOCATE=1
# SEED_FIXTURE=/app/fixtures/hacker-dojo-pilot.json
# SEED_ON_BOOT_STRICT=0
