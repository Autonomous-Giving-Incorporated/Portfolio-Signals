NODE_ENV=production
ORG_ID=org_pilot
PORT=8787
DATA_FILE=/data/state.json
OPERATOR_TOKEN=change-me-min-16-chars
WEBHOOK_TOKEN=change-me-min-16-chars
PROOF_SLA_HOURS=72
PUBLIC_BASE_URL=https://your-app.fly.dev

# Director login (Supabase) — preferred over OPERATOR_TOKEN in production
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ALLOW_OPERATOR_TOKEN_FALLBACK=0

SEED_ON_BOOT=0
SEED_ALLOCATE=1
