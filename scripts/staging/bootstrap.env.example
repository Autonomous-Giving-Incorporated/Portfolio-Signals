# Copy to bootstrap.env (never commit real secrets).
# Public client values only in browser-facing config.

# Platform project public endpoint (ref utdioxwiskzatwoejgiu)
PLATFORM_SUPABASE_URL=https://utdioxwiskzatwoejgiu.supabase.co
PLATFORM_SUPABASE_ANON_KEY=
PLATFORM_CONFIRM_PROJECT_REF=utdioxwiskzatwoejgiu
# Optional aliases used by older scripts:
# STAGING_SUPABASE_URL=$PLATFORM_SUPABASE_URL
# STAGING_SUPABASE_ANON_KEY=$PLATFORM_SUPABASE_ANON_KEY

# Local disposable project defaults (supabase start)
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_ANON_KEY=

# Optional: database URL for psql-based verification against local stack only
# DB_URL is emitted by `supabase status -o env` and must not be committed.
# DB_URL=

# Service-role key belongs only in a secret manager / function runtime.
# SUPABASE_SERVICE_ROLE_KEY=

APP_BASE_URL=http://127.0.0.1:8080
PINNED_SUPABASE_CLI=2.31.8
PINNED_NODE=22.18.0
PINNED_DENO=2.2.7
PINNED_POSTGRES=15.8
