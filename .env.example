# Public client configuration only. Never commit service-role keys.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server-only values belong in the deployment secret manager.
SUPABASE_SERVICE_ROLE_KEY=
FIELD_ENCRYPTION_KEY=
EVERY_ORG_EXPORT_BUCKET=
APP_BASE_URL=http://localhost:3000

# Optional Mailosaur probe. Never commit the API key. Default CI skips live mail.
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=qpbqeifu
# Optional. Must be @<server>.mailosaur.net after the Auth user exists.
MAILOSAUR_ASSIGNED_EMAIL=
